#!/usr/bin/env ruby

require_relative "../application.rb"

Application.name = "komar_bot"
Application.trap_signals!
Application.establish_activerecord!
logger = Application.logger
chat_logger = Application.chat_logger

polling_interval = Application.settings.dig("telegram_bot", "polling_interval") || 10

MESSAGES = ['Иди на хуй', 'Хуита', 'Съеби']

offset = TelegramUpdate.order('id DESC').first.try(:id)
logger.debug "starting with offset #{offset.inspect}"

bot = Telegram::Bot::Client.new(
  Application.telegram_bot_token,
  offset: offset,
  timeout: polling_interval,
)

begin
  logger.info 'listening to telegram'
  bot.fetch_updates do |message|
    TelegramUpdate.find_or_create_by(id: bot.options[:offset])
    logger.debug message.to_json
    log_line = sprintf "<= %8s: %s", message.chat.id, message.text
         logger.info log_line
    chat_logger.info log_line

    text = MESSAGES.sample
    message = { chat_id: message.chat.id, text: text }
    log_line = sprintf "=> %8s: %s", message[:chat_id], message[:text]
         logger.info log_line
    chat_logger.info log_line
    begin
      bot.api.send_message message
    rescue Telegram::Bot::Exceptions::ResponseError => e
      logger.info e.inspect
    end
  end while Application.running
rescue => e
  logger.error e.inspect
  e.backtrace.each do |line|
    logger.error line
  end
  exit 0 unless Application.running
  Application.handle_if_db_connection_problem(e)
  Application.exit_point
  logger.info "reconnecting to telegram in a couple of seconds"
  sleep 2
  retry
end
